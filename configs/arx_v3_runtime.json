{
  "engine_name": "ARX Platform v3.0",
  "subtitle": "C++-First Real-Time Gesture Intelligence and Spatial AR Engine",
  "runtime": {
    "target_fps": 60,
    "fixed_timestep_hz": 120,
    "latency_budget_ms": 20.0,
    "headless": false,
    "enable_profiler": true,
    "enable_remote_services": false
  },
  "cameras": [
    {
      "id": 0,
      "name": "primary",
      "width": 1280,
      "height": 720,
      "fps": 60
    }
  ],
  "tracking": {
    "enable_hands": true,
    "enable_face": true,
    "enable_world_landmarks": true,
    "models_dir": "models",
    "hand_model_path": "models/hand_landmarker.task",
    "face_model_path": "models/face_landmarker.task",
    "live_stream_mode": false,
    "max_hands": 2,
    "max_faces": 1,
    "min_hand_detection_confidence": 0.5,
    "min_hand_presence_confidence": 0.5,
    "min_hand_tracking_confidence": 0.5,
    "min_face_detection_confidence": 0.5,
    "min_face_presence_confidence": 0.5,
    "min_face_tracking_confidence": 0.5,
    "disable_gesture_classifier": false,
    "debug_gestures": false,
    "disable_debounce": false,
    "gesture_threshold": 0.5
  },
  "gesture_engine": {
    "pinch_threshold": 0.05,
    "swipe_velocity_threshold": 0.12,
    "hover_depth_window": 12
  },
  "recording": {
    "session_dir": "sessions",
    "record_frames": true,
    "record_gestures": true
  },
  "dashboard": {
    "enabled": true,
    "theme": "aether-dark",
    "show_profiler": true
  }
}
